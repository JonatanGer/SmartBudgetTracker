@model SmartBudgetTracker.Models.Transaction

@{
    ViewData["Title"] = "Radera transaktion";
}

<h2>Radera transaktion</h2>

<p>Är du säker på att du vill radera denna transaktion?</p>

<div class="mb-3">
    <p><strong>Beskrivning:</strong> @Model.Description</p>
    <p><strong>Belopp:</strong> @Model.Amount.ToString("N2", new System.Globalization.CultureInfo("sv-SE"))</p>
    <p><strong>Kategori:</strong> @Model.Category</p>
    <p><strong>Typ:</strong> @(Model.Type == "Income" ? "Inkomst" : "Utgift")</p>
</div>

<!-- Bekräftar att transaktionen ska raderas -->
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Radera</button>
    <a asp-action="Index" class="btn btn-secondary">Avbryt</a>
</form>
