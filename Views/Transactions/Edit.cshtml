@model SmartBudgetTracker.Models.Transaction

@{
    ViewData["Title"] = "Redigera transaktion";
}

<h2>Redigera transaktion</h2>

<form asp-action="Edit" method="post">

    <!-- Behåller transaktionens ID -->
    <input type="hidden" asp-for="Id" />

    <!-- Beskrivning -->
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Beskrivning</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <!-- Belopp -->
    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Belopp (kr)</label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <!-- Kategori -->
    <div class="mb-3">
        <label asp-for="Category" class="form-label">Kategori</label>
        <select asp-for="Category" class="form-select">
            <option value="Mat">Mat</option>
            <option value="Transport">Transport</option>
            <option value="Shopping">Shopping</option>
            <option value="Lön">Lön</option>
            <option value="Övrigt">Övrigt</option>
        </select>
    </div>

    <!-- Inkomst eller utgift -->
    <div class="mb-3">
        <label asp-for="Type" class="form-label">Typ</label>
        <select asp-for="Type" class="form-select">
            <option value="Income">Inkomst</option>
            <option value="Expense">Utgift</option>
        </select>
    </div>

    <!-- Datum -->
    <div class="mb-3">
        <label asp-for="Date" class="form-label">Datum</label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Spara ändringar</button>
    <a asp-action="Index" class="btn btn-secondary">Avbryt</a>

</form>
